{
  "installCommand": "cd apps/web && npm install",
  "buildCommand": "cd apps/web && npx vite build",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.whosthrowingshade.us"
        }
      ],
      "destination": "https://whosthrowingshade.us/$1",
      "permanent": true
    }
  ],
  "cleanUrls": true
}
