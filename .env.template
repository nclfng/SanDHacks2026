# Copy to .env (repo root) and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Bright Data (M2 scraping)
BRIGHTDATA_API=
BRIGHTDATA_UNLOCKER_ZONE=

# Mastra Platform
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# ElevenLabs voice agent (see agent/README.md)
ELEVENLABS_API_KEY=
# printed by `npm run el:sync`
ELEVENLABS_AGENT_ID=
# printed by `npm run el:import-number`
ELEVENLABS_PHONE_NUMBER_ID=
# from the post-call webhook in the ElevenLabs dashboard
ELEVENLABS_WEBHOOK_SECRET=
# optional; defaults to the voice in agent/agent.config.ts
ELEVENLABS_VOICE_ID=
# any long random string (openssl rand -hex 32); ElevenLabs sends it on tool calls
EL_TOOL_SECRET=
# public URL of apps/api (ngrok during dev), no trailing slash
PUBLIC_API_URL=

GEMINI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# optional: a Twilio API key pair (SID starts with SK). Sends use it only when both are set; otherwise the auth token
TWILIO_SID=
TWILIO_SECRET=
# E.164, e.g. +16195551234
TWILIO_PHONE_NUMBER=
# optional (M4): 1 = log outgoing texts instead of sending them (still writes calls rows)
M4_SMS_DRY_RUN=
# dev only (M4): where `node src/m4/dev/run.mjs send-test` sends, E.164
TEST_PHONE_NUMBER=
# public URL for Twilio webhooks (M4), no trailing slash. Webhooks: /m4/twilio/sms (phone number), /m4/twilio/whatsapp (WhatsApp sender), /m4/twilio/messenger (Facebook Messenger sender)
PUBLIC_BASE_URL=
# optional (M4): WhatsApp sender number, E.164; defaults to TWILIO_PHONE_NUMBER
TWILIO_WHATSAPP_FROM=
# optional (M4): Content SID (HX...) of the approved WhatsApp alert template, and a Spanish one; without it WhatsApp alerts only reach people who wrote in the last 24 hours
TWILIO_WHATSAPP_ALERT_CONTENT_SID=
TWILIO_WHATSAPP_ALERT_CONTENT_SID_ES=
# any long random string (openssl rand -hex 32); the dashboard's mock-alert button sends it as "Authorization: Bearer <secret>" (M4)
M4_ALERT_SECRET=
# optional (M4): Page access token for the Shadoes Facebook Page; used only to read a Messenger subscriber's name from their profile
FACEBOOK_PAGE_ACCESS_TOKEN=
# optional (M4): 1 = send_sms falls back to SMS for callers without a linked Messenger profile (off until carrier registration)
M4_SMS_ENABLED=
# optional (M4): reading-alert lines (defaults 103 and 101) and a cron to check readings automatically, e.g. */15 * * * *
M4_ALERT_HEAT_INDEX_F=
M4_ALERT_AQI=
M4_READING_ALERT_CRON=

# Phone hashing (contracts.md); same value for the whole team
PHONE_SALT=

# NWS API requires a User-Agent with contact info, e.g. "shade (team@example.com)"
NWS_USER_AGENT=

# Neon
NEON_API_KEY=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

CONTEXT_DEV_API_KEY=

# find_sites: how old (hours) a site's last_verified_at may be before it is skipped. Default 24; use 168 while demoing on the Nov 14 seed.
SITE_MAX_AGE_HOURS=

# find_sites: Google Geocoding for precise caller locations (addresses, cross streets, landmarks). Without it, find_sites
# falls back to Census + zip/area lookups. The dashboard's zone detail also uses it for rating, photo and status.
# Enable only the Geocoding API and Places API (New), and restrict the key to those two.
GOOGLE_MAPS_API_KEY=

# optional, TEST ONLY: 1 = "North Pole" callers get the fake 24/7 Santa Claus House site (and only it). Never set in production.
FIND_SITES_TEST_NORTH_POLE=
